# Copy this file to .env and edit local values.
# Do not commit .env.

METABASE_IMAGE=metabase/metabase:latest
METABASE_CONTAINER_NAME=metabase-hanadb
METABASE_PORT=3000

MB_APP_DB_NAME=metabaseappdb
MB_APP_DB_USER=metabase
MB_APP_DB_PASS=change-me-locally
MB_APP_DB_PORT=5432

METABASE_SRC_DIR=.worktrees/metabase
METABASE_REF=master

HANA_HOST=hana.example.com
HANA_PORT=30015
HANA_USER=example_user
HANA_PASS=
HANA_DATABASE=
HANA_SCHEMA=
HANA_SSL=false
HANA_TEST_QUERY=SELECT 1 AS HEALTHCHECK FROM DUMMY

HANA_NGDBC_JAR=/absolute/path/to/ngdbc.jar
MB_PLUGINS_HOST_DIR=/opt/metabase/plugins
